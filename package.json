{
  "name": "algorithms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript playground for practicing algorithms and data structures",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/playground.ts",
    "exec": "tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "tsx scripts/new-task.ts",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
